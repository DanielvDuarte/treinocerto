# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_publica

# ===== Anthropic (só no servidor, nunca exposta ao navegador) =====
ANTHROPIC_API_KEY=sk-ant-sua-chave

# URL pública do site (redirect de login). Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Mídia dos exercícios (CHAVE DE ROLLBACK) =====
# "svg"       -> usa nosso mapa muscular próprio (padrão, seguro p/ comercial)
# "gymvisual" -> usa os GIFs do dataset (© Gym Visual; só p/ teste pessoal
#                até licenciar). Requer rodar: node scripts/fetch-media.mjs
NEXT_PUBLIC_EXERCISE_MEDIA=svg
# Opcional: de onde servir a mídia (padrão pasta local). Pode virar CDN/R2 depois.
NEXT_PUBLIC_EXERCISE_MEDIA_BASE=/exercise-media
